---
import Icon from './ui/Icon.astro';
import { phoneLink, whatsappLink } from '~/lib/contact';
import { langOf } from '~/lib/i18n';
interface Props { whatsappText?: string; href?: string }
const lang = langOf(Astro.url.pathname);
const tel = phoneLink();
const wa = whatsappLink(Astro.props.whatsappText ?? (lang === 'en' ? 'Hello, I am interested in office cleaning in Berlin.' : 'Hallo, ich interessiere mich für eine Reinigung in Berlin.'));
const quote = lang === 'en' ? { href: '/en/contact/', label: 'Request a free site visit' } : { href: Astro.props.href ?? '/angebot/', label: 'Kostenlos anfragen' };
const hide = ['/angebot/', '/en/contact/'].some((p) => Astro.url.pathname.startsWith(p));
---
{!hide && (
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 px-3 pb-[max(0.6rem,env(safe-area-inset-bottom))] pt-2.5 backdrop-blur-[2px] lg:hidden" data-sticky-bar>
    <div class="flex gap-2">
      {tel && (
        <a href={tel} class="btn btn-ghost min-h-12 flex-1 px-3" data-track="phone_click">
          <Icon name="phone" size={20} />{lang === 'en' ? 'Call' : 'Anrufen'}
        </a>
      )}
      {wa && (
        <a href={wa} class="btn btn-ghost min-h-12 flex-1 px-3" data-track="whatsapp_click" rel="noopener">
          <Icon name="whatsapp" size={20} />WhatsApp
        </a>
      )}
      <a href={quote.href} class:list={['btn btn-primary min-h-12 px-4', tel || wa ? 'flex-1' : 'w-full']}>
        {tel || wa ? (lang === 'en' ? 'Quote' : 'Angebot') : quote.label}
        <Icon name="arrow" size={18} class="arrow" />
      </a>
    </div>
  </div>
)}

<script>
  // Leiste ausblenden, solange ein Anfrageformular sichtbar ist (verdeckt sonst die Buttons)
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  const forms = document.querySelectorAll('[data-msf]');
  if (bar && forms.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      bar.classList.toggle('translate-y-full', visible.size > 0);
    });
    bar.classList.add('transition-transform', 'duration-300');
    forms.forEach((f) => io.observe(f));
  }
</script>
