---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import { getCollection } from 'astro:content';
import { alternateOf, langOf } from '~/lib/i18n';

const path = Astro.url.pathname;
const lang = langOf(path);
const alt = alternateOf(path);
const services = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);

const nav =
  lang === 'en'
    ? [
        { label: 'Office cleaning', href: '/en/office-cleaning-berlin/' },
        { label: 'Services', href: '/en/services/' },
        { label: 'Contact', href: '/en/contact/' },
      ]
    : [
        { label: 'Leistungen', href: '/leistungen/', sub: true },
        { label: 'Garantie', href: '/garantie/' },
        { label: 'Ratgeber', href: '/ratgeber/' },
        { label: 'Über uns', href: '/ueber-uns/' },
      ];
const switchHref = lang === 'en' ? alt.de ?? '/' : alt.en ?? '/en/';
const cta = lang === 'en' ? { label: 'Get a quote', href: '/en/contact/' } : { label: 'Angebot anfragen', href: '/angebot/' };
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-paper/95 backdrop-blur-[2px] transition-[border-color] duration-300 data-[scrolled]:border-line">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
    {lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen'}
  </a>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-6">
    <Logo href={lang === 'en' ? '/en/' : '/'} />

    <nav aria-label={lang === 'en' ? 'Main' : 'Hauptnavigation'} class="hidden lg:block">
      <ul class="flex items-center gap-8 text-[0.98rem]">
        {nav.map((item) => (
          <li class:list={[item.sub && 'group relative']}>
            <a href={item.href} class="link-grow py-2" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.sub && (
              <div class="invisible absolute left-1/2 top-full z-50 w-[36rem] -translate-x-1/2 pt-4 opacity-0 transition duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="grid grid-cols-2 gap-x-6 rounded-xl border border-line bg-paper p-5 shadow-[0_20px_40px_-20px_rgb(15_46_35/0.35)]">
                  {services.map((s, i) => (
                    <li class="border-b border-line last:border-0 [&:nth-last-child(2)]:border-0">
                      <a href={`/${s.id}/`} class="flex items-baseline gap-3 py-2.5 hover:text-moss">
                        <span class="num text-xs text-stone">{String(i + 1).padStart(2, '0')}</span>
                        <span>{s.data.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={switchHref} class="link-grow hidden text-sm font-medium sm:inline" hreflang={lang === 'en' ? 'de' : 'en'} lang={lang === 'en' ? 'de' : 'en'}>
        {lang === 'en' ? 'Deutsch' : 'English'}
      </a>
      <a href={cta.href} class="btn btn-ink hidden min-h-11 px-5 text-[0.95rem] sm:inline-flex">
        {cta.label}<Icon name="arrow" size={18} class="arrow" />
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={lang === 'en' ? 'Open menu' : 'Menü öffnen'}
        data-label-open={lang === 'en' ? 'Open menu' : 'Menü öffnen'}
        data-label-close={lang === 'en' ? 'Close menu' : 'Menü schließen'}>
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close hidden" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-line bg-paper lg:hidden">
    <nav class="wrap py-6" aria-label={lang === 'en' ? 'Mobile' : 'Mobile Navigation'}>
      <ul class="divide-y divide-line border-y border-line">
        {nav.map((item) => (
          <li><a href={item.href} class="flex items-center justify-between py-4 font-display text-2xl font-semibold tracking-tight">{item.label}<Icon name="arrow" size={20} /></a></li>
        ))}
        {lang === 'de' && services.map((s) => (
          <li><a href={`/${s.id}/`} class="block py-3 pl-4 text-[1.02rem]">{s.data.name}</a></li>
        ))}
      </ul>
      <div class="mt-6 flex items-center justify-between">
        <a href={switchHref} class="link-moss font-medium" hreflang={lang === 'en' ? 'de' : 'en'}>{lang === 'en' ? 'Deutsch' : 'English'}</a>
        <a href={cta.href} class="btn btn-primary">{cta.label}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu')!;
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) || '');
    menu.classList.toggle('hidden', !open);
    toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('overflow-hidden', open);
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
