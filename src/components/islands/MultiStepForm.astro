---
/**
 * Anfrageformular in 3 Schritten (Objekt → Umfang & Ort → Kontakt).
 *
 * Versand: POST an /api/anfrage (Anfrage-Server im selben Container, siehe server/server.mjs).
 * Der Server speichert jede Anfrage und schickt sie per E-Mail weiter. Danach geht es zur Danke-Seite.
 * Ohne JavaScript funktioniert das Formular als normales HTML-Formular (alle Schritte sichtbar, siehe .no-js in global.css).
 * Das Markup ist bereits im Zustand „Schritt 1" gerendert, damit beim Laden nichts springt.
 * Spam-Schutz: Honeypot + Mindest-Ausfüllzeit + Rate-Limit auf dem Server, kein CAPTCHA.
 * Conversion: Google Ads (mit Anfrage-Nr. als transaction_id) und GA4, nur nach Einwilligung.
 */
import Icon from '../ui/Icon.astro';
import { offer } from '~/config/offer';
import { site } from '~/config/site';

interface Props {
  lang?: 'de' | 'en';
  id?: string;
  source?: string;
  heading?: boolean;
  /** Leistung, über die die Anfrage kommt (z. B. Landingpage „Praxisreinigung") */
  leistung?: string;
  /** Vorauswahl Objektart (Wert aus offer.configurator.objectTypes) */
  objekt?: string;
  /** schmale Variante für die Formular-Karte im Hero */
  compact?: boolean;
}
const { lang = 'de', id = 'anfrage', source = Astro.url.pathname, heading = true, leistung = '', objekt = '', compact = false } = Astro.props;
const c = offer.configurator;
const de = lang === 'de';

const objectTypesEn = ['Office', 'Medical practice / law firm', 'Stairwell / residential building', 'Shop / studio', 'Coworking', 'Other'];
const areasEn = ['up to 100 m²', '100–250 m²', '250–500 m²', '500–1,000 m²', 'over 1,000 m²', 'not sure'];
const freqEn = ['daily', '3× a week', '2× a week', 'weekly', 'every 2 weeks', 'one-off'];

const t = de
  ? {
      title: 'Kostenlose Objektbegehung anfragen',
      intro: `Drei kurze Schritte, etwa eine Minute. Wir melden uns ${offer.response.promise}.`,
      steps: ['Objekt', 'Umfang', 'Kontakt'],
      s1: 'Was sollen wir reinigen?',
      s2a: 'Wie groß ist die Fläche ungefähr?', s2b: 'Wie oft soll gereinigt werden?', s2c: 'In welchem Bezirk?', outside: 'außerhalb Berlins',
      name: 'Ihr Name', company: 'Firma / Praxis (optional)', phone: 'Telefon (optional, für einen schnellen Rückruf)', email: 'E-Mail',
      msg: 'Noch etwas, das wir wissen sollten? (optional)',
      next: 'Weiter', back: 'Zurück', submit: 'Kostenlose Objektbegehung anfragen',
      required: 'Bitte auswählen.', reqText: 'Bitte ausfüllen.', badEmail: 'Bitte eine gültige E-Mail-Adresse eingeben.',
      privacy: 'Ihre Angaben verwenden wir nur, um Ihre Anfrage zu beantworten.', privacyLink: 'Datenschutz',
      stepOf: 'Schritt', of: 'von', choose: 'Bitte wählen',
      reassure: 'Kostenlos und unverbindlich',
      small: 'Wir betreuen vor allem Büros und Gewerbeflächen ab 100 m². Schicken Sie Ihre Anfrage trotzdem gern ab, wir melden uns.',
      thanks: '/danke/',
      sending: 'Wird gesendet …',
      fail: 'Das hat leider nicht geklappt. Bitte versuchen Sie es noch einmal oder schreiben Sie uns an',
      tooMany: 'Es wurden gerade sehr viele Anfragen gesendet. Bitte versuchen Sie es in ein paar Minuten noch einmal oder schreiben Sie uns an',
    }
  : {
      title: 'Request a free site visit',
      intro: 'Three short steps, about one minute. We reply on the same working day.',
      steps: ['Premises', 'Scope', 'Contact'],
      s1: 'What should we clean?',
      s2a: 'Roughly how large is the area?', s2b: 'How often?', s2c: 'Which district?', outside: 'outside Berlin',
      name: 'Your name', company: 'Company (optional)', phone: 'Phone (optional, for a quick call back)', email: 'Email',
      msg: 'Anything else we should know? (optional)',
      next: 'Next', back: 'Back', submit: 'Request a free site visit',
      required: 'Please choose one.', reqText: 'Please fill in.', badEmail: 'Please enter a valid email address.',
      privacy: 'We only use your details to answer your enquiry.', privacyLink: 'Privacy policy',
      stepOf: 'Step', of: 'of', choose: 'Please choose',
      reassure: 'Free and without obligation',
      small: 'We mainly look after offices and commercial spaces from 100 m². Feel free to send your enquiry anyway.',
      thanks: '/en/contact/thanks/',
      sending: 'Sending …',
      fail: 'Sorry, that did not work. Please try again or email us at',
      tooMany: 'A lot of enquiries were just sent. Please try again in a few minutes or email us at',
    };
const objectTypes = de ? c.objectTypes : objectTypesEn;
const areas = de ? c.areas : areasEn;
const freqs = de ? c.frequencies : freqEn;
const grid3 = compact ? 'grid-cols-2' : 'grid-cols-2 sm:grid-cols-3';
---
<div class="msf" data-msf data-thanks={t.thanks} data-lang={lang} data-sending={t.sending} id={id}>
  {heading && (
    <div class="mb-6">
      <h2 class="text-3xl sm:text-4xl">{t.title}</h2>
      <p class="mt-2 text-stone">{t.intro}</p>
    </div>
  )}

  <div class="msf-progress mb-6" data-progress aria-hidden="true">
    <div class="flex justify-between text-sm">
      <span class="font-medium" data-progress-text>{t.stepOf} 1 {t.of} 3</span>
      <span class="text-stone" data-progress-name>{t.steps[0]}</span>
    </div>
    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line"><div class="h-full w-1/3 rounded-full bg-moss transition-[width] duration-500" data-bar></div></div>
  </div>
  <p class="sr-only" aria-live="polite" data-step-announce></p>

  <form action="/api/anfrage" method="post" novalidate data-form data-steps={JSON.stringify(t.steps)}>
    <input type="hidden" name="quelle" value={source} />
    <input type="hidden" name="leistung" value={leistung} />
    <input type="hidden" name="sprache" value={lang} />
    <input type="hidden" name="t" value="" data-started />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <!-- Schritt 1 -->
    <fieldset class="msf-step" data-step="1">
      <legend class="sr-only">{t.steps[0]}</legend>
      <div role="radiogroup" aria-labelledby={`${id}-s1`} data-required-group="objektart">
        <p id={`${id}-s1`} class="field-label text-lg">{t.s1} <span aria-hidden="true">*</span></p>
        <div class:list={['grid gap-2.5', grid3]}>
          {objectTypes.map((o, i) => (
            <label class="tile is-radio"><input type="radio" name="objektart" value={o} data-key={c.objectTypes[i]} checked={objekt === c.objectTypes[i]} required data-autonext /><span class="tile-title">{o.replace(' / ', '\u00a0/ ')}</span></label>
          ))}
        </div>
        <p class="field-error hidden" data-error-for="objektart">{t.required}</p>
      </div>
    </fieldset>

    <!-- Schritt 2 -->
    <fieldset class="msf-step mt-8 hidden space-y-6" data-step="2">
      <legend class="sr-only">{t.steps[1]}</legend>
      <div role="radiogroup" aria-labelledby={`${id}-s2a`} data-required-group="flaeche">
        <p id={`${id}-s2a`} class="field-label text-lg">{t.s2a} <span aria-hidden="true">*</span></p>
        <div class:list={['grid gap-2.5', grid3]}>
          {areas.map((a) => <label class="tile is-radio"><input type="radio" name="flaeche" value={a} required /><span class="tile-title">{a}</span></label>)}
        </div>
        <p class="field-error hidden" data-error-for="flaeche">{t.required}</p>
        <p class="mt-2 hidden text-sm text-stone" data-small-hint>{t.small}</p>
      </div>
      <div role="radiogroup" aria-labelledby={`${id}-s2b`} data-required-group="haeufigkeit">
        <p id={`${id}-s2b`} class="field-label text-lg">{t.s2b} <span aria-hidden="true">*</span></p>
        <div class:list={['grid gap-2.5', grid3]}>
          {freqs.map((f) => <label class="tile is-radio"><input type="radio" name="haeufigkeit" value={f} required /><span class="tile-title">{f}</span></label>)}
        </div>
        <p class="field-error hidden" data-error-for="haeufigkeit">{t.required}</p>
      </div>
      <div>
        <label class="field-label text-lg" for={`${id}-bezirk`}>{t.s2c} <span aria-hidden="true">*</span></label>
        <select id={`${id}-bezirk`} name="bezirk" class="field" required aria-describedby={`${id}-bezirk-err`}>
          <option value="">{t.choose}</option>
          {site.districts.map((d) => <option value={d.name}>{d.name}</option>)}
          <option value={t.outside}>{t.outside}</option>
        </select>
        <p id={`${id}-bezirk-err`} class="field-error hidden" data-error-for="bezirk">{t.required}</p>
      </div>
    </fieldset>

    <!-- Schritt 3 -->
    <fieldset class:list={['msf-step mt-8 hidden grid gap-5', !compact && 'sm:grid-cols-2']} data-step="3">
      <legend class="sr-only">{t.steps[2]}</legend>
      <div>
        <label class="field-label" for={`${id}-name`}>{t.name} <span aria-hidden="true">*</span></label>
        <input id={`${id}-name`} name="name" class="field" autocomplete="name" required aria-describedby={`${id}-name-err`} />
        <p id={`${id}-name-err`} class="field-error hidden" data-error-for="name">{t.reqText}</p>
      </div>
      <div>
        <label class="field-label" for={`${id}-email`}>{t.email} <span aria-hidden="true">*</span></label>
        <input id={`${id}-email`} name="email" type="email" class="field" autocomplete="email" inputmode="email" required aria-describedby={`${id}-email-err`} />
        <p id={`${id}-email-err`} class="field-error hidden" data-error-for="email">{t.badEmail}</p>
      </div>
      <div>
        <label class="field-label" for={`${id}-tel`}>{t.phone}</label>
        <input id={`${id}-tel`} name="telefon" type="tel" class="field" autocomplete="tel" inputmode="tel" />
      </div>
      <div>
        <label class="field-label" for={`${id}-firma`}>{t.company}</label>
        <input id={`${id}-firma`} name="firma" class="field" autocomplete="organization" />
      </div>
      <div class:list={[!compact && 'sm:col-span-2']}>
        <label class="field-label" for={`${id}-msg`}>{t.msg}</label>
        <textarea id={`${id}-msg`} name="nachricht" rows="2" class="field"></textarea>
      </div>
      <p class:list={['text-sm text-stone', !compact && 'sm:col-span-2']}>
        {t.privacy} <a href="/datenschutz/" class="link-moss">{t.privacyLink}</a>
      </p>
    </fieldset>

    <div class="mt-8 flex flex-wrap items-center gap-3" data-nav>
      <button type="button" class="btn btn-ghost hidden" data-back>{t.back}</button>
      <button type="button" class="btn btn-ink" data-next>{t.next}<Icon name="arrow" size={18} class="arrow" /></button>
      <button type="submit" class:list={['btn btn-primary hidden', compact && 'w-full']} data-submit><span data-submit-label>{t.submit}</span><Icon name="arrow" size={18} class="arrow" /></button>
      <p class="flex w-full items-center gap-2 text-sm text-stone"><Icon name="check" size={16} class="text-moss" />{t.reassure} · {de ? `Rückmeldung ${offer.response.promise}` : 'Reply on the same working day'}</p>
      <p class="field-error hidden w-full" role="alert" data-fail>{t.fail} <a class="underline" href={`mailto:${site.leadEmail}`}>{site.leadEmail}</a>.</p>
      <p class="field-error hidden w-full" role="alert" data-toomany>{t.tooMany} <a class="underline" href={`mailto:${site.leadEmail}`}>{site.leadEmail}</a>.</p>
    </div>
  </form>
</div>

<script>
  import { track } from '~/lib/track';
  import { sendLead, bezirkFromUrl, EMAIL_RE as EMAIL, SMALL_AREA } from '~/lib/lead';


  document.querySelectorAll<HTMLElement>('[data-msf]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const steps = [...root.querySelectorAll<HTMLElement>('.msf-step')];
    const back = root.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const announce = root.querySelector<HTMLElement>('[data-step-announce]')!;
    const progressText = root.querySelector<HTMLElement>('[data-progress-text]')!;
    const progressName = root.querySelector<HTMLElement>('[data-progress-name]')!;
    const names: string[] = JSON.parse(form.dataset.steps || '[]');
    const en = root.dataset.lang === 'en';
    let current = 0;
    let started = false;

    form.querySelector<HTMLInputElement>('[data-started]')!.value = String(Date.now());

    const show = (i: number, focus = true) => {
      current = i;
      steps.forEach((s, k) => s.classList.toggle('hidden', k !== i));
      back.classList.toggle('hidden', i === 0);
      next.classList.toggle('hidden', i === steps.length - 1);
      submit.classList.toggle('hidden', i !== steps.length - 1);
      bar.style.width = `${((i + 1) / steps.length) * 100}%`;
      const label = `${en ? 'Step' : 'Schritt'} ${i + 1} ${en ? 'of' : 'von'} ${steps.length}`;
      progressText.textContent = label;
      progressName.textContent = names[i] || '';
      announce.textContent = label;
      if (focus) {
        const r = root.getBoundingClientRect();
        if (r.top < 0 || r.top > window.innerHeight * 0.4) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
        steps[i].querySelector<HTMLElement>('input:not([type=hidden]):not([type=radio]), select, textarea')?.focus({ preventScroll: true });
      }
    };

    const setErr = (name: string, on: boolean) => {
      root.querySelector(`[data-error-for="${name}"]`)?.classList.toggle('hidden', !on);
      form.querySelectorAll<HTMLInputElement>(`[name="${name}"]`).forEach((el) => el.setAttribute('aria-invalid', String(on)));
    };

    const fieldValid = (el: HTMLInputElement | HTMLSelectElement) => {
      const v = el.value.trim();
      return v !== '' && (el.type !== 'email' || EMAIL.test(v));
    };

    const validateStep = (i: number, focus = true) => {
      let ok = true;
      let first: HTMLElement | null = null;
      steps[i].querySelectorAll<HTMLElement>('[data-required-group]').forEach((g) => {
        const name = g.dataset.requiredGroup!;
        const has = !!form.querySelector(`[name="${name}"]:checked`);
        setErr(name, !has);
        if (!has) { ok = false; first ??= g.querySelector<HTMLElement>('input'); }
      });
      steps[i].querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[required]:not([type=radio]), select[required]').forEach((el) => {
        const valid = fieldValid(el);
        setErr(el.name, !valid);
        if (!valid) { ok = false; first ??= el; }
      });
      if (focus) first?.focus();
      return ok;
    };

    const go = (i: number) => {
      show(i);
      track('form_step', { step: i + 1 });
    };

    // Fehler beim Verlassen eines Feldes anzeigen, beim Korrigieren sofort ausblenden
    // (nicht erst beim Verlassen – sonst verschiebt sich das Layout zwischen mousedown und mouseup)
    form.addEventListener('focusout', (e) => {
      const el = e.target as HTMLInputElement;
      if (!el.required || el.type === 'radio') return;
      if (el.value !== '' && !fieldValid(el)) setErr(el.name, true);
    });
    const onEdit = (e: Event) => {
      const el = e.target as HTMLInputElement;
      if (!started) { started = true; track('form_start', {}); }
      if (el.type === 'radio') return setErr(el.name, false);
      if (el.required && el.getAttribute('aria-invalid') === 'true' && fieldValid(el)) setErr(el.name, false);
    };
    form.addEventListener('change', onEdit);
    form.addEventListener('input', onEdit);

    // Schritt 1: Auswahl genügt, es geht automatisch weiter
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.matches('[data-autonext]') && current === 0) setTimeout(() => go(1), 220);
    });

    next.addEventListener('click', () => { if (validateStep(current)) go(current + 1); });
    back.addEventListener('click', () => show(current - 1));

    show(0, false);
    // ?bezirk=spandau → Bezirk vorauswählen
    const bz = bezirkFromUrl();
    const sel = form.querySelector<HTMLSelectElement>('select[name="bezirk"]');
    if (bz && sel) sel.value = bz.district;
    // Hinweis bei Flächen unter 100 m²
    const smallHint = root.querySelector<HTMLElement>('[data-small-hint]');
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'flaeche') smallHint?.classList.toggle('hidden', el.value !== SMALL_AREA);
    });
    if (new URLSearchParams(location.search).has('fehler')) root.querySelector('[data-fail]')!.classList.remove('hidden');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Alle Schritte prüfen – bei Fehler zum betroffenen Schritt springen
      for (let i = 0; i < steps.length; i++) {
        if (!validateStep(i, false)) { show(i); validateStep(i); return; }
      }
      await sendLead(form, {
        submit,
        label: submitLabel,
        sending: root.dataset.sending || '…',
        fail: root.querySelector<HTMLElement>('[data-fail]')!,
        tooMany: root.querySelector<HTMLElement>('[data-toomany]')!,
        thanks: root.dataset.thanks!,
      });
    });
  });
</script>
