---
/**
 * Vorher-Nachher-Slider. Basis ist ein natives <input type="range">:
 * Tastatur (Pfeile, Pos1/Ende), Touch und Screenreader funktionieren ohne Zusatzcode.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption: string;
  example?: boolean;
  lang?: 'de' | 'en';
}
const { before, after, beforeAlt, afterAlt, caption, example = false, lang = 'de' } = Astro.props;
const L = lang === 'en' ? { b: 'Before', a: 'After', range: 'Move the divider between before and after', ex: 'Example image – not our own work' } : { b: 'Vorher', a: 'Nachher', range: 'Trennlinie zwischen Vorher und Nachher verschieben', ex: 'Beispielbild – keine eigene Arbeit' };
const sizes = '(min-width: 64rem) 45vw, 100vw';
---
<figure class="ba">
  <div class="ba-frame relative aspect-[4/3] select-none overflow-hidden rounded-xl bg-paper-2" style="--pos:50%" data-ba>
    <!-- STOCK: später durch eigenes Foto ersetzen -->
    <Image src={after} alt={afterAlt} widths={[480, 800, 1200]} sizes={sizes} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    <div class="absolute inset-0" style="clip-path: inset(0 calc(100% - var(--pos)) 0 0)">
      <!-- STOCK: später durch eigenes Foto ersetzen -->
      <Image src={before} alt={beforeAlt} widths={[480, 800, 1200]} sizes={sizes} class="h-full w-full object-cover" loading="lazy" />
    </div>
    <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-ink px-3 py-1 text-xs font-medium text-paper">{L.b}</span>
    <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-paper px-3 py-1 text-xs font-medium text-ink">{L.a}</span>
    <div class="pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-paper" style="left: var(--pos)">
      <span class="absolute left-1/2 top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-paper text-ink shadow-md">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6 3.5 12 9 18M15 6l5.5 6-5.5 6"/></svg>
      </span>
    </div>
    <input type="range" min="0" max="100" value="50" step="1" aria-label={L.range} aria-valuetext="50 %" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
  </div>
  <figcaption class="mt-3 flex flex-wrap items-baseline justify-between gap-2 text-[0.95rem]">
    <span>{caption}</span>
    {example && <span class="text-sm text-stone">{L.ex}</span>}
  </figcaption>
</figure>

<style>
  .ba-range:focus-visible + * { outline: none; }
  .ba-frame:has(.ba-range:focus-visible) { outline: 3px solid var(--color-moss); outline-offset: 3px; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((frame) => {
    const r = frame.querySelector<HTMLInputElement>('.ba-range')!;
    const set = () => {
      frame.style.setProperty('--pos', `${r.value}%`);
      r.setAttribute('aria-valuetext', `${r.value} %`);
    };
    r.addEventListener('input', set);
    set();
  });
</script>
