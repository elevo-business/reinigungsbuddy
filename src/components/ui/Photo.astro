---
/**
 * Bild-Komponente: optimiert (AVIF/WebP, srcset), explizite Maße.
 * Stockfotos tauschen: neue Datei in src/assets/images/ legen und den Import ersetzen.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  /** Klassen für das <img> */
  class?: string;
  /** Klassen für das <picture> */
  wrapClass?: string;
  stock?: boolean;
}
const { src, alt, sizes = '100vw', widths = [480, 768, 1080, 1440, 1920], priority = false, class: cls = '', wrapClass = '', stock = true } = Astro.props;
const w = widths.filter((x) => x <= src.width);
---
{stock && <Fragment set:html="<!-- STOCK: später durch eigenes Foto ersetzen -->" />}
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={w.length ? w : [src.width]}
  sizes={sizes}
  class={cls}
  pictureAttributes={{ class: wrapClass }}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
/>
