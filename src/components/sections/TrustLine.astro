---
import Icon from '../ui/Icon.astro';
interface Props { lang?: 'de' | 'en'; class?: string }
const { lang = 'de', class: cls = '' } = Astro.props;
const items = lang === 'en'
  ? [['tag', 'Fixed price after a free site visit'], ['person', 'One contact person'], ['document', 'Cleaning report after every visit']]
  : [['tag', 'Festpreis nach kostenloser Objektbegehung'], ['person', 'Ein fester Ansprechpartner'], ['document', 'Reinigungsprotokoll nach jedem Einsatz']];
---
<ul class:list={['flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem]', cls]}>
  {items.map(([icon, text]) => (
    <li class="flex items-center gap-2"><Icon name={icon} size={20} class="shrink-0 text-moss [.on-dark_&]:text-mint" />{text}</li>
  ))}
</ul>
