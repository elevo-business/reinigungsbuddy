---
import Signet from '../ui/Signet.astro';
import Photo from '../ui/Photo.astro';
import { site } from '~/config/site';
import type { ImageMetadata } from 'astro';
interface Props { num: number; quote?: string; lang?: 'de' | 'en' }
const { num, lang = 'de' } = Astro.props;
const quote = Astro.props.quote ?? (lang === 'en'
  ? 'I don’t want to win customers with long contracts, but with offices that are clean on Monday morning. If something is not right, you message me directly, not a hotline.'
  : 'Ich will Kunden nicht mit langen Verträgen halten, sondern mit Büros, die am Montagmorgen sauber sind. Wenn etwas nicht passt, schreiben Sie mir direkt und nicht einer Hotline.');
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{jpg,jpeg,png,webp}', { eager: true });
const ownerPhoto = site.owner.photo ? photos[`/src/assets/images/${site.owner.photo}`]?.default : undefined;
---
<section class="wrap py-20 lg:py-28" aria-labelledby={`s${num}`}>
  <div class="grid-12 items-center gap-y-10 border-t border-line pt-5">
    <p class="eyebrow col-span-4 lg:col-span-12"><span class="num">{String(num).padStart(2, '0')}</span> — {lang === 'en' ? 'Who you deal with' : 'Mit wem Sie es zu tun haben'}</p>
    <div class="col-span-4 lg:col-span-4">
      {ownerPhoto ? (
        <Photo src={ownerPhoto} alt={`${site.owner.firstName}, ${site.owner.role} von ${site.name}`} sizes="(min-width: 64rem) 30vw, 100vw" class="aspect-[4/5] w-full rounded-2xl object-cover" stock={false} />
      ) : (
        <div class="relative flex aspect-[4/5] w-full flex-col items-center justify-center gap-4 overflow-hidden rounded-2xl bg-ink text-fog">
          <Signet class="h-24 w-auto" />
          <span class="ph text-sm">[Platzhalter: Foto von {site.owner.firstName}]</span>
        </div>
      )}
    </div>
    <div class="col-span-4 lg:col-span-7 lg:col-start-6">
      <h2 id={`s${num}`} class="text-display">{lang === 'en' ? `Hi, I’m ${site.owner.firstName}.` : `Ich bin ${site.owner.firstName}.`}</h2>
      <blockquote class="mt-6 font-display text-2xl font-medium leading-snug tracking-tight sm:text-[1.9rem]">„{quote}“</blockquote>
      <p class="mt-6 text-stone">
        {site.owner.firstName}, {lang === 'en' ? 'owner of' : site.owner.role + ' von'} {site.name}.{' '}
        {lang === 'en' ? 'Plans every job personally, does the site visits and is on site cleaning.' : 'Plant jeden Auftrag selbst, macht die Objektbegehungen und reinigt selbst mit.'}
      </p>
      <a href={lang === 'en' ? '/en/contact/' : '/ueber-uns/'} class="link-moss mt-5 inline-block">{lang === 'en' ? 'Get in touch' : 'Mehr über Reinigungsbuddy'}</a>
    </div>
  </div>
</section>
