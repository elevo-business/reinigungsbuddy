---
import LeadMagnetForm from '../islands/LeadMagnetForm.astro';
import Icon from '../ui/Icon.astro';
interface Props { num: number; id?: string }
const { num, id = 'lv-block' } = Astro.props;
---
<section class="wrap py-16 lg:py-24" aria-labelledby={`s${num}`}>
  <div class="grid-12 gap-y-8 rounded-3xl border border-ink p-6 sm:p-10 lg:p-14">
    <div class="col-span-4 lg:col-span-5">
      <p class="eyebrow text-moss"><span class="num">{String(num).padStart(2, '0')}</span> — Gratis</p>
      <h2 id={`s${num}`} class="mt-4 text-4xl sm:text-5xl">Ihr Leistungsverzeichnis, kostenlos.</h2>
    </div>
    <div class="col-span-4 lg:col-span-7">
      <p class="text-lead">Welche Fläche wie oft gereinigt wird, schwarz auf weiß, abgestimmt auf Ihr Büro. Damit vergleichen Sie Angebote fair, auch wenn Sie danach nicht bei uns buchen.</p>
      <ul class="mt-5 grid gap-2 text-[0.98rem] sm:grid-cols-2">
        {['Räume und Flächen mit Intervall', 'Sanitär, Küche, Glas getrennt', 'Was enthalten ist, was nicht', 'Als PDF, sofort weiterleitbar'].map((x) => (
          <li class="flex gap-2.5"><Icon name="check" size={20} class="shrink-0 text-moss" />{x}</li>
        ))}
      </ul>
      <div class="mt-8"><LeadMagnetForm id={id} /></div>
    </div>
  </div>
</section>
