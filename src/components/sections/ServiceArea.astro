---
/**
 * Einsatzgebiet: alle 12 Bezirke als Text + schlichte SVG-Karte (keine externe Karte, kein Tracking).
 * Kartengrundlage: Amt für Statistik Berlin-Brandenburg (via Berliner Morgenpost, CC BY) – siehe CREDITS.md.
 */
import SectionHeader from './SectionHeader.astro';
import { site } from '~/config/site';
import map from '~/data/berlin-bezirke.json';
interface Props { num: number; lang?: 'de' | 'en' }
const { num, lang = 'de' } = Astro.props;
const t = lang === 'en'
  ? { label: 'Service area', title: 'All 12 Berlin districts.', intro: 'From Spandau to Marzahn-Hellersdorf, from Reinickendorf to Treptow-Köpenick. Viewings are free everywhere in Berlin.', map: 'Map of Berlin with its 12 districts – all served by Reinigungsbuddy', src: 'Map data: Amt für Statistik Berlin-Brandenburg, CC BY' }
  : { label: 'Einsatzgebiet', title: 'Alle 12 Berliner Bezirke.', intro: 'Von Spandau bis Marzahn-Hellersdorf, von Reinickendorf bis Treptow-Köpenick. Die Besichtigung ist überall in Berlin kostenlos.', map: 'Karte von Berlin mit den 12 Bezirken – alle gehören zum Einsatzgebiet von Reinigungsbuddy', src: 'Kartengrundlage: Amt für Statistik Berlin-Brandenburg, CC BY' };
const short: Record<string, string> = {
  'friedrichshain-kreuzberg': 'Friedrichshain-\nKreuzberg', 'charlottenburg-wilmersdorf': 'Charlottenburg-\nWilmersdorf', 'steglitz-zehlendorf': 'Steglitz-\nZehlendorf',
  'tempelhof-schoeneberg': 'Tempelhof-\nSchöneberg', 'treptow-koepenick': 'Treptow-\nKöpenick', 'marzahn-hellersdorf': 'Marzahn-\nHellersdorf',
};
const nudge: Record<string, [number, number]> = { mitte: [0, 4], 'friedrichshain-kreuzberg': [8, 0], 'tempelhof-schoeneberg': [0, 10], neukoelln: [-2, 0] };
---
<section class="wrap py-20 lg:py-28" aria-labelledby={`s${num}`}>
  <SectionHeader num={num} label={t.label} title={t.title} intro={t.intro} id={`s${num}`} />
  <div class="grid-12 mt-12 items-start gap-y-10">
    <figure class="col-span-4 lg:col-span-6">
      <svg viewBox={`-10 -10 ${map.width + 20} ${map.height + 20}`} class="h-auto w-full" role="img" aria-label={t.map}>
        {map.districts.map((d) => (
          <path d={d.d} class="fill-paper-2 stroke-ink transition-colors duration-300 hover:fill-mint-soft" stroke-width="1.5" stroke-linejoin="round" />
        ))}
        {map.districts.map((d) => {
          const [dx, dy] = nudge[d.slug] ?? [0, 0];
          const lines = (short[d.slug] ?? d.name).split('\n');
          return (
            <text x={d.cx + dx} y={d.cy + dy - (lines.length - 1) * 11} text-anchor="middle" class="fill-ink font-sans" font-size="21" font-weight="500" aria-hidden="true">
              {lines.map((l, i) => <tspan x={d.cx + dx} dy={i === 0 ? 0 : 23}>{l}</tspan>)}
            </text>
          );
        })}
      </svg>
      <figcaption class="mt-2 text-xs text-stone">{t.src}</figcaption>
    </figure>
    <ul class="col-span-4 grid gap-x-8 sm:grid-cols-2 lg:col-span-5 lg:col-start-8">
      {site.districts.map((d) => (
        <li class="border-b border-line py-3">
          <span class="font-display text-lg font-semibold tracking-tight">{d.name}</span>
          <span class="block text-sm text-stone">{d.areas.join(', ')}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
