---
import MultiStepForm from '../islands/MultiStepForm.astro';
import TrustLine from './TrustLine.astro';
import Icon from '../ui/Icon.astro';
import { whatsappLink } from '~/lib/contact';
import { offer } from '~/config/offer';
interface Props { num: number; title?: string; text?: string; whatsappText?: string; lang?: 'de' | 'en' }
const { num, lang = 'de' } = Astro.props;
const title = Astro.props.title ?? (lang === 'en' ? 'Your fixed quote, within 24 hours.' : 'Ihr Festpreis, in 24 Stunden.');
const text = Astro.props.text ?? (lang === 'en' ? 'Tell us about your premises. We reply on the same working day and arrange a free viewing.' : `Erzählen Sie uns kurz von Ihren Räumen. Wir melden uns ${offer.response.promise} und vereinbaren eine kostenlose Besichtigung.`);
const wa = whatsappLink(Astro.props.whatsappText ?? 'Hallo, ich hätte gern ein Festpreis-Angebot.');
---
<section class="on-dark py-20 lg:py-28" aria-labelledby={`s${num}`} id="anfrage-bereich">
  <div class="wrap grid-12 gap-y-12">
    <div class="col-span-4 lg:col-span-4">
      <p class="eyebrow text-fog"><span class="num">{String(num).padStart(2, '0')}</span> — {lang === 'en' ? 'Enquiry' : 'Anfrage'}</p>
      <h2 id={`s${num}`} class="mt-4 text-display">{title}</h2>
      <p class="mt-5 text-lead text-fog">{text}</p>
      <TrustLine lang={lang} class="mt-8 flex-col !gap-3" />
      {wa && (
        <a href={wa} class="btn btn-ghost mt-8" data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" size={20} />{lang === 'en' ? 'Message on WhatsApp' : 'Direkt per WhatsApp'}</a>
      )}
    </div>
    <div class="col-span-4 rounded-2xl bg-paper p-5 text-ink sm:p-8 lg:col-span-7 lg:col-start-6">
      <MultiStepForm lang={lang} id={`anfrage-${num}`} heading={false} />
    </div>
  </div>
</section>
