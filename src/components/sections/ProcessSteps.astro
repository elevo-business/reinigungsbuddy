---
import SectionHeader from './SectionHeader.astro';
import { offer } from '~/config/offer';
interface Props { num?: number; steps?: { title: string; text: string }[]; label?: string; title?: string; intro?: string }
const { steps = offer.process, label = 'Ablauf', title = 'So einfach geht’s', intro } = Astro.props;
const stepWord = Astro.url.pathname.startsWith('/en/') ? 'Step' : 'Schritt';
---
<section class="wrap py-20 lg:py-24" aria-labelledby="ablauf">
  <SectionHeader label={label} title={title} intro={intro} id="ablauf" />
  <ol class="mt-12 grid gap-8 md:grid-cols-3">
    {steps.map((s, i) => (
      <li class="border-t-2 border-ink pt-5">
        <span class="num font-display text-sm font-semibold text-moss">{stepWord} {i + 1}</span>
        <h3 class="mt-2 text-2xl">{s.title}</h3>
        <p class="mt-2 text-stone">{s.text}</p>
      </li>
    ))}
  </ol>
</section>
