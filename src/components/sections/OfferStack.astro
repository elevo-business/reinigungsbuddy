---
/** Die vier Zusagen – hell, ruhig, ohne Effekte. */
import SectionHeader from './SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { offer } from '~/config/offer';
import { offerEn } from '~/config/offer.en';
interface Props { num?: number; title?: string; intro?: string; lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;
const en = lang === 'en';
const title = Astro.props.title ?? (en ? 'What you get with us' : 'Was Sie bei uns bekommen');
const intro = Astro.props.intro;
const pillars = en ? offerEn.pillars : offer.pillars;
---
<section class="wrap py-20 lg:py-24" aria-labelledby="zusagen">
  <SectionHeader label={en ? 'Why Reinigungsbuddy' : 'Warum Reinigungsbuddy'} title={title} intro={intro} id="zusagen" />
  <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {pillars.map((p) => (
      <li class="rounded-2xl border border-line bg-white/50 p-6">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-mint-soft text-ink"><Icon name={p.icon} size={22} /></span>
        <h3 class="mt-5 text-xl">{p.title}</h3>
        <p class="mt-2 text-[0.98rem] text-stone">{p.text}</p>
        {p.key === 'garantie' && !en && <a href="/garantie/" class="link-moss mt-3 inline-block text-[0.95rem]">Bedingungen ansehen</a>}
      </li>
    ))}
  </ul>
</section>
