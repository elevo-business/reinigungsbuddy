---
import SectionHeader from './SectionHeader.astro';
import Icon from '../ui/Icon.astro';
interface Props { num: number; title: string; included: { group: string; items: string[] }[]; excluded: string[]; lang?: 'de' | 'en' }
const { num, title, included, excluded, lang = 'de' } = Astro.props;
const t = lang === 'en'
  ? { label: 'Scope', intro: 'This is the basis of your service schedule. We fix intervals and extras together at the viewing.', inc: 'Included', exc: 'Not included (available on request)' }
  : { label: 'Leistungsumfang', intro: 'Das ist die Grundlage Ihres Leistungsverzeichnisses. Intervalle und Extras legen wir bei der Besichtigung gemeinsam fest.', inc: 'Enthalten', exc: 'Nicht enthalten (auf Wunsch zubuchbar)' };
---
<section class="wrap py-20 lg:py-28" aria-labelledby={`s${num}`}>
  <SectionHeader num={num} label={t.label} title={title} intro={t.intro} id={`s${num}`} />
  <div class="grid-12 mt-14 gap-y-12">
    <div class="col-span-4 lg:col-span-8">
      <h3 class="eyebrow text-moss">{t.inc}</h3>
      <div class="mt-5 grid gap-x-8 gap-y-10 sm:grid-cols-2">
        {included.map((g) => (
          <div class="reveal">
            <h4 class="border-b border-ink pb-2 text-lg">{g.group}</h4>
            <ul class="mt-3 space-y-2.5">
              {g.items.map((it) => (
                <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-moss" /><span>{it}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <aside class="col-span-4 lg:col-span-4">
      <div class="rounded-xl border border-line bg-paper-2/70 p-6">
        <h3 class="eyebrow">{t.exc}</h3>
        <ul class="mt-4 space-y-2.5 text-[0.98rem]">
          {excluded.map((it) => (
            <li class="flex gap-3"><Icon name="minus" size={20} class="mt-0.5 shrink-0 text-stone" /><span>{it}</span></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>
