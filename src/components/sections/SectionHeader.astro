---
import { shy } from '~/lib/text';
/** Schlichter Abschnittskopf: kleines Label, Überschrift, optional ein Satz Einleitung. */
interface Props { num?: number | string; label?: string; title: string; intro?: string; id?: string; wide?: boolean; center?: boolean }
const { label, title, intro, id, center = false } = Astro.props;
---
<div class:list={['max-w-3xl', center && 'mx-auto text-center']}>
  {label && <p class="eyebrow text-moss">{label}</p>}
  <h2 id={id} class="mt-3 text-[clamp(1.9rem,2.6vw+0.8rem,3rem)] leading-[1.08]">{shy(title)}</h2>
  {intro && <p class="mt-4 text-lead text-stone">{intro}</p>}
</div>
