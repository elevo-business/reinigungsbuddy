---
import { shy } from '~/lib/text';
interface Props { num?: number | string; label: string; title: string; intro?: string; id?: string; wide?: boolean }
const { num, label, title, intro, id, wide = false } = Astro.props;
const n = typeof num === 'number' ? String(num).padStart(2, '0') : num;
---
<div class="grid-12 gap-y-5 border-t border-line pt-5">
  <p class="eyebrow col-span-4 lg:col-span-3 opacity-80">{n && <span class="num">{n}</span>}{n && ' — '}{label}</p>
  <div class:list={['col-span-4', wide ? 'lg:col-span-9' : 'lg:col-span-8']}>
    <h2 id={id} class="text-display">{shy(title)}</h2>
    {intro && <p class="mt-5 max-w-2xl text-lead opacity-85">{intro}</p>}
  </div>
</div>
