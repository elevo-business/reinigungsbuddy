---
import '~/styles/global.css';
import SEO from '~/components/SEO.astro';
import SchemaOrg from '~/components/SchemaOrg.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import StickyMobileBar from '~/components/StickyMobileBar.astro';
import ConsentBanner from '~/components/ConsentBanner.astro';
import ExitIntent from '~/components/islands/ExitIntent.astro';
import Logo from '~/components/ui/Logo.astro';
import Icon from '~/components/ui/Icon.astro';
import { phoneLink } from '~/lib/contact';
import { site } from '~/config/site';
import { langOf } from '~/lib/i18n';
import { localBusiness, website } from '~/lib/schema';
import { bezirkMap } from '~/lib/bezirke';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  whatsappText?: string;
  /** 'landing' = Google-Ads-Landingpage: ohne Navigation, schlanker Footer, Sticky-Button springt zum Formular */
  variant?: 'default' | 'landing';
}
const { title, description, image, noindex, type, schema = [], whatsappText, variant = 'default' } = Astro.props;
const landing = variant === 'landing';
const a = site.analytics;
/** Konfiguration für die Browser-Skripte (Google-Ads-Labels, erlaubte ?bezirk=-Werte) */
const cfg = JSON.stringify({
  ads: a.googleAdsId ? { id: a.googleAdsId, lead: a.googleAdsLabel, phone: a.googleAdsPhoneLabel, email: a.googleAdsEmailLabel } : {},
  bezirke: bezirkMap(),
}).replace(/</g, '\\u003c');
const needsConsent = Boolean(site.analytics.metaPixelId || site.analytics.ga4Id || site.analytics.googleAdsId);
const lang = langOf(Astro.url.pathname);
const base = Astro.site!;
const graph = [localBusiness(base), website(base), ...schema];
const plausible = site.analytics.plausibleDomain;
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'de'} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <link rel="preload" href="/fonts/GeneralSans-Semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} image={image} noindex={noindex} type={type} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4F3EF" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SchemaOrg data={graph} />
    {plausible && <script is:inline defer data-domain={plausible} src={site.analytics.plausibleScript}></script>}
    <slot name="head" />
    <script type="application/json" id="rb-cfg" set:html={cfg} />
  </head>
  <body class="min-h-dvh">
    {landing ? (
      <header class="border-b border-line bg-paper">
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Zum Inhalt springen</a>
        <div class="wrap flex h-16 items-center justify-between gap-4">
          <Logo href="#main" />
          {phoneLink() ? (
            <a href={phoneLink()!} class="btn btn-ghost min-h-11 px-4 text-[0.95rem]" data-track="phone_click"><Icon name="phone" size={18} />{site.contact.phone}</a>
          ) : (
            <p class="hidden items-center gap-2 text-[0.95rem] text-stone sm:flex"><Icon name="check" size={18} class="text-moss" />Kostenlos und unverbindlich</p>
          )}
        </div>
      </header>
    ) : <Header />}
    <main id="main">
      <slot />
    </main>
    {landing ? (
      <footer class="border-t border-line pb-28 pt-8 lg:pb-10">
        <div class="wrap flex flex-col gap-3 text-sm text-stone sm:flex-row sm:items-center sm:justify-between">
          <p>© {new Date().getFullYear()} {site.name} · Gebäudereinigung in Berlin</p>
          <ul class="flex flex-wrap gap-x-5 gap-y-2">
            <li><a class="link-grow" href="/impressum/">Impressum</a></li>
            <li><a class="link-grow" href="/datenschutz/">Datenschutz</a></li>
            <li><a class="link-grow" href="/agb/">AGB</a></li>
            {needsConsent && <li><button type="button" class="link-grow" data-consent-open>Cookie-Einstellungen</button></li>}
          </ul>
        </div>
      </footer>
    ) : <Footer />}
    <StickyMobileBar whatsappText={whatsappText} href={landing ? '#anfrage-karte' : undefined} />
    <ConsentBanner />
    {!landing && <ExitIntent />}

    <script>
      import { initTracking } from '~/lib/track';
      initTracking();

      // Dezente Scroll-Reveals (respektieren prefers-reduced-motion via CSS)
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
