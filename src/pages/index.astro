---
/**
 * Startseite – bewusst schlicht:
 * Hero · So einfach geht's · Leistungen · Was Sie bekommen · Einsatzgebiet · Fragen · Anfrage
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import SectionHeader from '~/components/sections/SectionHeader.astro';
import ProcessSteps from '~/components/sections/ProcessSteps.astro';
import OfferStack from '~/components/sections/OfferStack.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import FAQ from '~/components/sections/FAQ.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import { offer } from '~/config/offer';
import { site } from '~/config/site';
import { hasStimmen } from '~/lib/collections';
import { whatsappLink } from '~/lib/contact';
import { faqPage } from '~/lib/schema';
import heroImg from '~/assets/images/buero-flur-glastueren-tageslicht.jpg';

const services = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
const wa = whatsappLink('Hallo, ich interessiere mich für eine Gebäudereinigung in Berlin.');
const faqs = [
  { q: 'Was kostet eine Gebäudereinigung in Berlin?', a: 'Das hängt von Fläche, Häufigkeit, Bodenbelägen, Sanitärräumen und Zeitfenster ab. Deshalb nennen wir keine Pauschalen. Nach der kostenlosen Objektbegehung erhalten Sie innerhalb von 24 Stunden einen Festpreis für genau Ihr Objekt.' },
  { q: 'In welchen Bezirken sind Sie unterwegs?', a: 'In allen 12 Berliner Bezirken, von Spandau bis Marzahn-Hellersdorf und von Reinickendorf bis Treptow-Köpenick. Die Objektbegehung ist überall kostenlos.' },
  offer.commonFaq[1],
  offer.commonFaq[3],
  offer.commonFaq[4],
];
const url = new URL('/', Astro.site).toString();
---
<BaseLayout
  title="Gebäudereinigung Berlin – Festpreis 24 h | Reinigungsbuddy"
  description="Gebäudereinigung in Berlin für Büros, Praxen und Treppenhäuser. Fester Ansprechpartner, Reinigungsprotokoll, Festpreis 24 h nach Objektbegehung."
  image="/og/home.png"
  schema={[faqPage(faqs, url)]}>

  <!-- Hero -->
  <section class="wrap pb-14 pt-12 lg:pb-20 lg:pt-20">
    <div class="max-w-4xl">
      <p class="eyebrow text-moss">Gebäudereinigung in Berlin</p>
      <h1 class="mt-5 text-[clamp(2.5rem,5vw+0.8rem,5rem)] leading-[1.02]">
        Gebäude&shy;reinigung in Berlin, um die Sie sich nicht kümmern müssen.
      </h1>
      <p class="mt-7 max-w-2xl text-lead text-stone">
        Wir reinigen Büros, Praxen und Treppenhäuser in ganz Berlin. Sie haben einen festen Ansprechpartner, bekommen nach jedem Einsatz ein Reinigungsprotokoll und innerhalb von 24 Stunden nach der Objektbegehung Ihren Festpreis.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/angebot/" class="btn btn-primary">Kostenlose Objektbegehung anfragen<Icon name="arrow" size={18} class="arrow" /></a>
        {wa ? (
          <a href={wa} class="btn btn-ghost" data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>
        ) : (
          <a href="#leistungen" class="btn btn-ghost">Leistungen ansehen</a>
        )}
      </div>
      <TrustLine class="mt-9" />
    </div>
  </section>

  <figure class="wrap">
    <Photo src={heroImg} alt="Heller Büroflur mit Glastüren, Holzboden und Tageslicht in einem modernen Bürogebäude" sizes="(min-width: 90rem) 1344px, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover sm:aspect-[21/9]" priority />
  </figure>

  <ProcessSteps />

  <!-- Leistungen -->
  <section id="leistungen" class="bg-paper-2/60 py-20 lg:py-24" aria-labelledby="leistungen-titel">
    <div class="wrap">
      <SectionHeader label="Leistungen" title="Alles, was in Ihren Räumen sauber sein muss" intro="Von der regelmäßigen Büroreinigung bis zur Endreinigung beim Auszug. Ein Ansprechpartner, eine Rechnung." id="leistungen-titel" />
      <ul class="mt-12 grid gap-x-10 sm:grid-cols-2">
        {services.map((s) => (
          <li class="border-b border-line">
            <a href={`/${s.id}/`} class="group flex items-start justify-between gap-4 py-5">
              <span>
                <span class="block font-display text-xl font-semibold tracking-tight transition-colors group-hover:text-moss">{s.data.name}</span>
                <span class="mt-1 block text-[0.95rem] text-stone">{s.data.teaser}</span>
              </span>
              <Icon name="arrow" size={20} class="mt-1.5 shrink-0 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <OfferStack />

  {hasStimmen && <Testimonials num={0} />}

  <!-- Einsatzgebiet (kurz) -->
  <section class="wrap pb-6" aria-labelledby="gebiet">
    <div class="rounded-2xl border border-line p-6 sm:p-8">
      <h2 id="gebiet" class="text-2xl">Im Einsatz in allen 12 Berliner Bezirken</h2>
      <p class="mt-3 text-stone">{site.districts.map((d) => d.name).join(' · ')}</p>
    </div>
  </section>

  <FAQ num={1} items={faqs} title="Häufige Fragen" />
  <FinalCTA num={2} />
</BaseLayout>
