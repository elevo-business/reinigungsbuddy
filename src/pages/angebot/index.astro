---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import MultiStepForm from '~/components/islands/MultiStepForm.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import Icon from '~/components/ui/Icon.astro';
import ClickToLoad from '~/components/islands/ClickToLoad.astro';
import { offer } from '~/config/offer';
import { whatsappLink, phoneLink } from '~/lib/contact';
import { site } from '~/config/site';
import { breadcrumbs } from '~/lib/schema';
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Angebot anfragen', href: '/angebot/' }];
const wa = whatsappLink('Hallo, ich hätte gern ein Festpreis-Angebot für eine Reinigung.');
const tel = phoneLink();
---
<BaseLayout
  title="Festpreis-Angebot anfragen | Reinigungsbuddy"
  description="Festpreis für Ihre Büro- oder Gebäudereinigung in Berlin anfragen: 4 kurze Schritte, Rückmeldung am selben Werktag, Festpreis 24 h nach Objektbegehung."
  schema={[breadcrumbs(crumbs, Astro.site!)]}>
  <section class="wrap pb-20 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="grid-12 mt-8 gap-y-10">
      <div class="col-span-4 lg:col-span-4">
        <p class="eyebrow text-moss">Anfrage</p>
        <h1 class="mt-5 text-[clamp(2.4rem,4vw+0.8rem,4.5rem)] leading-[1.02]">Kostenlose Objektbegehung anfragen.</h1>
        <p class="mt-6 text-lead">Vier kurze Schritte, etwa zwei Minuten. Wir melden uns {offer.response.promise} (Anfragen nach {offer.response.cutoff}: am nächsten Werktag) und vereinbaren eine kostenlose Objektbegehung, vor Ort.</p>
        <TrustLine class="mt-8 flex-col !gap-3" />
        <ol class="mt-10 space-y-4 border-t border-line pt-6">
          {offer.process.map((p, i) => (
            <li class="flex gap-4"><span class="num font-display font-semibold text-moss">{String(i + 1).padStart(2, '0')}</span><span><strong class="font-medium">{p.title}:</strong> <span class="text-stone">{p.text}</span></span></li>
          ))}
        </ol>
        {(wa || tel) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {tel && <a href={tel} class="btn btn-ghost" data-track="phone_click"><Icon name="phone" size={20} />{site.contact.phone}</a>}
            {wa && <a href={wa} class="btn btn-ghost" data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>}
          </div>
        )}
      </div>
      <div class="col-span-4 rounded-2xl border border-line bg-white/60 p-5 sm:p-8 lg:col-span-7 lg:col-start-6" id="anfrage-wrap">
        <MultiStepForm id="anfrage" heading={false} />
      </div>
    </div>
    {offer.switches.calcomUrl && (
      <div class="mt-16">
        <h2 class="text-3xl">Lieber direkt einen Termin für die Objektbegehung buchen?</h2>
        <div class="mt-6"><ClickToLoad src={offer.switches.calcomUrl} title="Termin für die Objektbegehung buchen" provider="Cal.com" /></div>
      </div>
    )}
  </section>
</BaseLayout>
