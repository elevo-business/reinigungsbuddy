---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import MultiStepForm from '~/components/islands/MultiStepForm.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import Icon from '~/components/ui/Icon.astro';
import ClickToLoad from '~/components/islands/ClickToLoad.astro';
import { offer } from '~/config/offer';
import { whatsappLink, phoneLink } from '~/lib/contact';
import { site } from '~/config/site';
import { breadcrumbs } from '~/lib/schema';
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Angebot anfragen', href: '/angebot/' }];
const wa = whatsappLink('Hallo, ich hätte gern ein Festpreis-Angebot für eine Reinigung.');
const tel = phoneLink();
---
<BaseLayout
  title="Festpreis-Angebot anfragen | Reinigungsbuddy"
  description="Kostenlose Objektbegehung für Ihre Büro- oder Gebäudereinigung in Berlin anfragen: 3 kurze Schritte, Rückmeldung am selben Werktag, Festpreis 24 h danach."
  schema={[breadcrumbs(crumbs, Astro.site!)]}>
  <section class="wrap pb-20 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="mt-8 grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:row-start-1">
        <p class="eyebrow text-moss">Anfrage</p>
        <h1 class="mt-5 text-[clamp(2.2rem,3.6vw+0.8rem,4.2rem)] leading-[1.03]">Kostenlose Objektbegehung anfragen.</h1>
        <p class="mt-5 text-lead text-stone">Drei kurze Schritte, etwa eine Minute. Wir melden uns {offer.response.promise} und vereinbaren einen Termin.</p>
      </div>
      <div class="rounded-2xl border border-line bg-white p-5 shadow-[0_24px_60px_-30px_rgb(15_46_35/0.35)] sm:p-8 lg:col-span-7 lg:row-span-2 lg:row-start-1" id="anfrage-wrap">
        <MultiStepForm id="anfrage" heading={false} />
      </div>
      <div class="lg:col-span-5 lg:row-start-2">
        <TrustLine class="flex-col !gap-3" />
        <ol class="mt-8 space-y-4 border-t border-line pt-6">
          {offer.process.map((p, i) => (
            <li class="flex gap-4"><span class="num font-display font-semibold text-moss">{i + 1}.</span><span><strong class="font-medium">{p.title}:</strong> <span class="text-stone">{p.text}</span></span></li>
          ))}
        </ol>
        {(wa || tel) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {tel && <a href={tel} class="btn btn-ghost" data-track="phone_click"><Icon name="phone" size={20} />{site.contact.phone}</a>}
            {wa && <a href={wa} class="btn btn-ghost" data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>}
          </div>
        )}
      </div>
    </div>
    {offer.switches.calcomUrl && (
      <div class="mt-16">
        <h2 class="text-3xl">Lieber direkt einen Termin für die Objektbegehung buchen?</h2>
        <div class="mt-6"><ClickToLoad src={offer.switches.calcomUrl} title="Termin für die Objektbegehung buchen" provider="Cal.com" /></div>
      </div>
    )}
  </section>
</BaseLayout>
