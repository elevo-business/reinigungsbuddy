---
/**
 * Google-Ads-Landingpages – eine je Leistung plus eine allgemeine (/lp/gebaeudereinigung-berlin/).
 *
 * Aufbau bewusst auf Anfragen ausgelegt:
 *  - keine Navigation (kein Weg weg von der Anfrage), schlanker Footer mit Pflichtlinks
 *  - Headline wiederholt das Suchwort der Anzeige (Message Match)
 *  - Formular sofort sichtbar, erster Schritt mit einem Klick erledigt
 *  - danach nur, was Zweifel ausräumt: Ablauf, Leistungsumfang, Zusagen, Fragen
 *
 * noindex: Die Seiten sind nur für Anzeigen gedacht und würden sonst mit den Leistungsseiten konkurrieren.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HeroLead from '~/components/sections/HeroLead.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import SectionHeader from '~/components/sections/SectionHeader.astro';
import ProcessSteps from '~/components/sections/ProcessSteps.astro';
import OfferStack from '~/components/sections/OfferStack.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import FAQ from '~/components/sections/FAQ.astro';
import { offer } from '~/config/offer';
import { site } from '~/config/site';
import { hasStimmen } from '~/lib/collections';
import { shy } from '~/lib/text';
import heroImg from '~/assets/images/buero-flur-glastueren-tageslicht.jpg';

export async function getStaticPaths() {
  const services = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
  /** Vorauswahl im Formular je Leistung */
  const objekt: Record<string, string> = {
    'praxisreinigung-berlin': 'Praxis / Kanzlei',
    'treppenhausreinigung-berlin': 'Treppenhaus / Wohnhaus',
    'bueroreinigung-berlin': 'Büro',
    'unterhaltsreinigung-berlin': 'Büro',
  };
  const generic = {
    params: { slug: 'gebaeudereinigung-berlin' },
    props: {
      name: 'Gebäudereinigung',
      sub: 'Büros, Praxen, Treppenhäuser und Gewerbeflächen in ganz Berlin. Mit festem Ansprechpartner und Reinigungsprotokoll nach jedem Einsatz.',
      image: heroImg,
      imageAlt: 'Heller Büroflur mit Glastüren, Holzboden und Tageslicht in einem modernen Bürogebäude',
      objekt: '',
      minArea: true,
      included: services.map((s) => s.data.name),
      includedTitle: 'Das übernehmen wir für Sie',
      faq: [] as { q: string; a: string }[],
    },
  };
  return [
    generic,
    ...services.map((s) => ({
      params: { slug: s.id },
      props: {
        name: s.data.name,
        sub: `${s.data.teaser} Mit festem Ansprechpartner und Reinigungsprotokoll nach jedem Einsatz.`,
        image: s.data.heroImage,
        imageAlt: s.data.heroAlt,
        objekt: objekt[s.id] ?? '',
        minArea: !['praxisreinigung-berlin', 'treppenhausreinigung-berlin'].includes(s.id),
        included: s.data.included.flatMap((g) => g.items).slice(0, 8),
        includedTitle: `Das gehört zur ${s.data.name}`,
        faq: s.data.faq.slice(0, 2),
      },
    })),
  ];
}

const p = Astro.props;
const { slug } = Astro.params;
const faqs = [
  { q: `Was kostet ${p.name === 'Gebäudereinigung' ? 'eine Gebäudereinigung' : 'die ' + p.name} in Berlin?`, a: 'Das hängt von Fläche, Häufigkeit, Bodenbelägen, Sanitärräumen und Zeitfenster ab. Deshalb nennen wir keine Pauschalen, die hinterher nicht stimmen. Nach der kostenlosen Objektbegehung erhalten Sie innerhalb von 24 Stunden einen schriftlichen Festpreis für genau Ihr Objekt.' },
  { q: 'Ist die Objektbegehung wirklich kostenlos?', a: 'Ja. Die Objektbegehung und das Angebot sind kostenlos und unverbindlich. Sie entscheiden danach in Ruhe.' },
  ...p.faq,
  offer.commonFaq[1],
  { q: 'Was passiert, wenn etwas nicht sauber ist?', a: offer.guarantee.short },
];
const long = `${p.name} Berlin – Festpreis 24 h | Reinigungsbuddy`;
const title = long.length <= 60 ? long : `${p.name} Berlin | Reinigungsbuddy`;
---
<BaseLayout
  variant="landing"
  noindex
  title={title}
  description={`${p.name} in Berlin: kostenlose Objektbegehung, Festpreis innerhalb von 24 Stunden danach, fester Ansprechpartner. Jetzt anfragen.`.slice(0, 155)}
  image="/og/leistung.png">

  <section class="wrap pb-14 pt-6 sm:pt-10 lg:pb-20 lg:pt-14">
    <HeroLead name={p.name} h1={`${shy(p.name)} in Berlin. Ihr Festpreis 24 Stunden nach der Objektbegehung.`.replace(/&(?!shy;)/g, '&amp;')} sub={p.sub} objekt={p.objekt} minArea={p.minArea} />
  </section>

  <figure class="wrap">
    <Photo src={p.image} alt={p.imageAlt} sizes="(min-width: 90rem) 1344px, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover sm:aspect-[21/9]" />
  </figure>

  <ProcessSteps />

  <section class="bg-paper-2/60 py-20 lg:py-24" aria-labelledby="umfang">
    <div class="wrap">
      <SectionHeader label="Leistungsumfang" title={p.includedTitle} intro="Was genau wir wann reinigen, legen wir bei der Objektbegehung gemeinsam fest und schreiben es ins Angebot." id="umfang" />
      <ul class="mt-10 grid gap-x-10 gap-y-3 sm:grid-cols-2">
        {p.included.map((i) => (
          <li class="flex gap-3 border-b border-line pb-3"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-moss" /><span>{i}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <OfferStack />

  {hasStimmen && <Testimonials num={0} />}

  <FAQ num={1} items={faqs} title="Häufige Fragen" />

  <section class="on-dark py-16 lg:py-20" aria-labelledby="los">
    <div class="wrap flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 id="los" class="text-display">Lassen Sie uns Ihr Objekt ansehen.</h2>
        <p class="mt-3 max-w-xl text-fog">Kostenlos und unverbindlich. Ihr Festpreis folgt innerhalb von 24 Stunden nach der Objektbegehung.</p>
      </div>
      <a href="#anfrage-karte" class="btn btn-primary">Kostenlose Objektbegehung anfragen<Icon name="arrow" size={18} class="arrow" /></a>
    </div>
  </section>
</BaseLayout>
