---
/**
 * Leistungsseite – Aufbau laut Konzept:
 * Hero + Direktantwort · Im Detail · Problem · Angebot · Leistungsumfang · Vorher/Nachher · Ablauf ·
 * Alles aus einer Hand · Vergleich · Garantie · Inhaber · FAQ · Final-CTA mit Formular
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import NeedsConfigurator from '~/components/islands/NeedsConfigurator.astro';
import FactsBlock from '~/components/sections/FactsBlock.astro';
import ProblemBlock from '~/components/sections/ProblemBlock.astro';
import OfferStack from '~/components/sections/OfferStack.astro';
import ScopeChecklist from '~/components/sections/ScopeChecklist.astro';
import BeforeAfterGallery from '~/components/sections/BeforeAfterGallery.astro';
import ProcessSteps from '~/components/sections/ProcessSteps.astro';
import AllInOneBlock from '~/components/sections/AllInOneBlock.astro';
import ComparisonTable from '~/components/sections/ComparisonTable.astro';
import GuaranteeBlock from '~/components/sections/GuaranteeBlock.astro';
import OwnerBlock from '~/components/sections/OwnerBlock.astro';
import FAQ from '~/components/sections/FAQ.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import { offer } from '~/config/offer';
import { hasStimmen } from '~/lib/collections';
import { shy } from '~/lib/text';
import { whatsappLink } from '~/lib/contact';
import { service, faqPage, breadcrumbs } from '~/lib/schema';

export async function getStaticPaths() {
  const items = await getCollection('leistungen');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = new URL(`/${entry.id}/`, Astro.site).toString();
const faqs = [...d.faq, ...offer.commonFaq];
const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Leistungen', href: '/leistungen/' },
  { name: d.name, href: `/${entry.id}/` },
];
const ratgeber = d.guide ? (await getCollection('ratgeber')).find((r) => r.id === d.guide) : undefined;
const wa = whatsappLink(d.whatsappText);
const showGallery = offer.switches.showGallery && (await getCollection('projekte')).length > 0;
let n = 0;
const next = () => ++n;
---
<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  image="/og/leistung.png"
  whatsappText={d.whatsappText}
  schema={[
    service({ name: d.name, serviceType: d.serviceType, description: d.directAnswer, url, base: Astro.site! }),
    faqPage(faqs, url),
    breadcrumbs(crumbs, Astro.site!),
  ]}>
  <!-- 01 Hero + Direktantwort -->
  <section class="wrap pb-14 pt-8 lg:pb-20 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="grid-12 mt-8 gap-y-10">
      <div class="col-span-4 lg:col-span-7">
        <p class="eyebrow text-moss"><span class="num">{String(next()).padStart(2, '0')}</span> — {d.name} in Berlin</p>
        <h1 class="mt-5 text-mega">{shy(d.h1)}</h1>
        <p class="mt-7 max-w-2xl text-lead">{d.directAnswer}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#anfrage-bereich" class="btn btn-primary">Festpreis in 24 h anfragen<Icon name="arrow" size={18} class="arrow" /></a>
          {wa ? (
            <a href={wa} class="btn btn-ghost" data-track="whatsapp_click" rel="noopener"><Icon name="whatsapp" size={20} />Direkt per WhatsApp</a>
          ) : (
            <a href="#leistungsumfang" class="btn btn-ghost">Was ist enthalten?<Icon name="arrow-down" size={18} /></a>
          )}
        </div>
        <TrustLine class="mt-8" />
      </div>
      <div class="col-span-4 lg:col-span-5">
        <NeedsConfigurator preset={d.preset} compact id={`cfg-${entry.id}`} />
      </div>
    </div>
  </section>

  <figure class="relative">
    <Photo src={d.heroImage} alt={d.heroAlt} sizes="100vw" class="h-[52vh] max-h-[40rem] min-h-[18rem] w-full object-cover" />
  </figure>

  <!-- Im Detail (Inhalt aus der MDX-Datei) -->
  <section class="wrap py-20 lg:py-28" aria-labelledby="detail">
    <div class="grid-12 gap-y-12">
      <div class="col-span-4 lg:col-span-7">
        <p class="eyebrow opacity-80"><span class="num">{String(next()).padStart(2, '0')}</span> — Im Detail</p>
        <div class="prose-rb mt-5">
          <Content />
        </div>
        {ratgeber && (
          <p class="mt-10 border-t border-line pt-5">
            Weiterlesen im Ratgeber: <a href={`/ratgeber/${ratgeber.id}/`} class="link-moss">{ratgeber.data.title}</a>
          </p>
        )}
      </div>
      <aside class="col-span-4 lg:col-span-4 lg:col-start-9">
        <div class="lg:sticky lg:top-28">
          <FactsBlock facts={d.facts} title={`${d.name}: Fakten`} />
        </div>
      </aside>
    </div>
  </section>

  <ProblemBlock num={next()} />
  <OfferStack num={next()} />
  <div id="leistungsumfang"><ScopeChecklist num={next()} title={`Das gehört zur ${d.name}`} included={d.included} excluded={d.excluded} /></div>
  {showGallery && <BeforeAfterGallery num={next()} />}
  <ProcessSteps num={next()} />
  <AllInOneBlock num={next()} current={entry.id} />
  <ComparisonTable num={next()} />
  <GuaranteeBlock num={next()} />
  {hasStimmen && <Testimonials num={next()} />}
  <OwnerBlock num={next()} />
  <FAQ num={next()} items={faqs} title={`Fragen zur ${d.name}`} />
  <FinalCTA num={next()} whatsappText={d.whatsappText} />
</BaseLayout>
