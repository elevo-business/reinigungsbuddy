---
/**
 * Leistungsseite – schlicht:
 * Hero + Direktantwort · Bild · Leistungsumfang · Im Detail (+ Fakten) · Was Sie bekommen · Ablauf · Fragen · Anfrage
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import HeroLead from '~/components/sections/HeroLead.astro';
import FactsBlock from '~/components/sections/FactsBlock.astro';
import ScopeChecklist from '~/components/sections/ScopeChecklist.astro';
import OfferStack from '~/components/sections/OfferStack.astro';
import SectionHeader from '~/components/sections/SectionHeader.astro';
import ProcessSteps from '~/components/sections/ProcessSteps.astro';
import FAQ from '~/components/sections/FAQ.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import { offer } from '~/config/offer';
import { hasStimmen } from '~/lib/collections';
import { shy } from '~/lib/text';
import { service, faqPage, breadcrumbs } from '~/lib/schema';
import { site } from '~/config/site';

export async function getStaticPaths() {
  const items = await getCollection('leistungen');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = new URL(`/${entry.id}/`, Astro.site).toString();
const faqs = [...d.faq, offer.commonFaq[0], offer.commonFaq[1], offer.commonFaq[4]];
const crumbs = [
  { name: 'Start', href: '/' },
  { name: 'Leistungen', href: '/leistungen/' },
  { name: d.name, href: `/${entry.id}/` },
];
const all = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
const related = all.filter((s) => s.id !== entry.id).slice(0, 9);
const ratgeber = d.guide ? (await getCollection('ratgeber')).find((r) => r.id === d.guide) : undefined;
/** Vorauswahl Objektart und Zielgruppen-Hinweis „ab 100 m²" je Leistung */
const objekt = ({ 'bueroreinigung-berlin': 'Büro', 'unterhaltsreinigung-berlin': 'Büro', 'praxisreinigung-berlin': 'Praxis / Kanzlei', 'treppenhausreinigung-berlin': 'Treppenhaus / Wohnhaus' } as Record<string, string>)[entry.id] ?? '';
const minArea = !['praxisreinigung-berlin', 'treppenhausreinigung-berlin'].includes(entry.id);
/** Bezirksliste für die Anzeigengruppen „Büroreinigung + Bezirk" */
const showDistricts = ['bueroreinigung-berlin', 'unterhaltsreinigung-berlin'].includes(entry.id);
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
---
<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  image="/og/leistung.png"
  whatsappText={d.whatsappText}
  schema={[
    service({ name: d.name, serviceType: d.serviceType, description: d.directAnswer, url, base: Astro.site! }),
    faqPage(faqs, url),
    breadcrumbs(crumbs, Astro.site!),
  ]}>
  <section class="wrap pb-14 pt-6 lg:pb-20 lg:pt-10">
    <Breadcrumbs items={crumbs} />
    <div class="mt-6 lg:mt-10">
      <HeroLead name={d.name} h1={esc(shy(d.h1))} sub={d.directAnswer} subShort={d.teaser} objekt={objekt} minArea={minArea} />
    </div>
  </section>

  <figure class="wrap">
    <Photo src={d.heroImage} alt={d.heroAlt} sizes="(min-width: 90rem) 1344px, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover sm:aspect-[21/9]" />
  </figure>

  <div id="leistungsumfang"><ScopeChecklist num={1} title={`Das gehört zur ${d.name}`} included={d.included} excluded={d.excluded} /></div>

  <section class="bg-paper-2/60 py-20 lg:py-24" aria-labelledby="detail">
    <div class="wrap grid-12 gap-y-10">
      <div class="col-span-4 lg:col-span-7">
        <p class="eyebrow text-moss">Im Detail</p>
        <div class="prose-rb mt-3"><Content /></div>
        {ratgeber && (
          <p class="mt-10 border-t border-line pt-5">
            Weiterlesen im Ratgeber: <a href={`/ratgeber/${ratgeber.id}/`} class="link-moss">{ratgeber.data.title}</a>
          </p>
        )}
      </div>
      <aside class="col-span-4 lg:col-span-4 lg:col-start-9">
        <div class="lg:sticky lg:top-28"><FactsBlock facts={d.facts} title="Auf einen Blick" /></div>
      </aside>
    </div>
  </section>

  {showDistricts && (
    <section class="wrap py-20 lg:py-24" aria-labelledby="bezirke">
      <SectionHeader label="Einsatzgebiet" title={`${d.name} in Ihrem Bezirk`} intro="Wir sind in allen 12 Berliner Bezirken im Einsatz. Die Objektbegehung ist überall kostenlos." id="bezirke" />
      <ul class="mt-10 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
        {site.districts.map((b) => (
          <li class="border-t border-line py-4">
            <h3 class="text-lg">{d.name} {b.name}</h3>
            <p class="mt-1 text-[0.95rem] text-stone">{b.areas.join(', ')}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <OfferStack />
  <ProcessSteps />
  {hasStimmen && <Testimonials num={0} />}
  <FAQ num={1} items={faqs} title={`Fragen zur ${d.name}`} />

  <section class="wrap pb-20" aria-labelledby="weitere">
    <h2 id="weitere" class="text-2xl">Weitere Leistungen</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {related.map((s) => <li><a href={`/${s.id}/`} class="chip transition-colors hover:border-ink">{s.data.name}</a></li>)}
    </ul>
  </section>

  <FinalCTA num={2} whatsappText={d.whatsappText} />
</BaseLayout>
