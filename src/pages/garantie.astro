---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import SectionHeader from '~/components/sections/SectionHeader.astro';
import FAQ from '~/components/sections/FAQ.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import { offer } from '~/config/offer';
import { breadcrumbs, faqPage } from '~/lib/schema';
const g = offer.guarantee;
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Garantie', href: '/garantie/' }];
const url = new URL('/garantie/', Astro.site).toString();
const steps = [
  { title: 'Kurz melden', text: 'Sie sehen etwas, das nicht in Ordnung ist? Schicken Sie uns innerhalb von 24 Stunden nach dem Einsatz eine kurze Nachricht, gern mit Foto.' },
  { title: 'Wir kommen wieder', text: 'Wir reinigen innerhalb von 24 Stunden (werktags) kostenlos nach.' },
  { title: 'Oder Sie zahlen nicht', text: 'Gelingt uns die Nachbesserung nicht rechtzeitig, berechnen wir diesen Einsatz nicht.' },
];
const faqs = [
  { q: 'Wie oft kann ich die Garantie nutzen?', a: 'Jedes Mal, wenn etwas nicht stimmt. Wiederholt sich ein Punkt, passen wir gemeinsam mit Ihnen Ablauf oder Intervall an.' },
  { q: 'Gilt die Garantie auch für einmalige Aufträge?', a: 'Ja, für alle Leistungen aus dem Angebot, also auch für Grund- und Endreinigungen. Bei Endreinigungen gilt sie bis zur Übergabe an den Vermieter, sofern wir Zugang zu den Räumen haben.' },
  { q: 'Was zählt als Werktag?', a: 'Montag bis Freitag, ohne gesetzliche Feiertage in Berlin. Melden Sie sich am Freitagabend, läuft die Frist bis Montagabend.' },
];
---
<BaseLayout
  title="Nachbesserungsgarantie | Reinigungsbuddy Berlin"
  description="Ist etwas nicht sauber, reinigen wir innerhalb von 24 Stunden (werktags) kostenlos nach. Gelingt das nicht, berechnen wir den Einsatz nicht."
  schema={[breadcrumbs(crumbs, Astro.site!), faqPage(faqs, url)]}>
  <section class="wrap pb-12 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="mt-10 max-w-3xl">
      <p class="eyebrow text-moss">Garantie</p>
      <h1 class="mt-5 text-[clamp(2.3rem,4.4vw+0.8rem,4.5rem)] leading-[1.04]">Nicht sauber? Dann kommen wir wieder.</h1>
      <p class="mt-6 text-lead text-stone">{g.short}</p>
    </div>
  </section>

  <section class="wrap pb-16" aria-labelledby="ablauf">
    <h2 id="ablauf" class="sr-only">So funktioniert die Garantie</h2>
    <ol class="grid gap-8 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="border-t-2 border-ink pt-5">
          <span class="num font-display text-sm font-semibold text-moss">Schritt {i + 1}</span>
          <h3 class="mt-2 text-2xl">{s.title}</h3>
          <p class="mt-2 text-stone">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-paper-2/60 py-20" aria-labelledby="bed">
    <div class="wrap">
      <SectionHeader label="Bedingungen" title="Die Bedingungen im Überblick" id="bed" />
      <ol class="mt-10 max-w-3xl">
        {g.conditions.map((c, i) => (
          <li class="flex gap-5 border-t border-line py-4"><span class="num font-display font-semibold text-moss">{i + 1}.</span><span>{c}</span></li>
        ))}
      </ol>
      <p class="mt-6 max-w-3xl text-sm text-stone">Die Garantie gilt zusätzlich zu Ihren gesetzlichen Rechten. Die verbindliche Fassung ist Teil Ihres Angebots.</p>
    </div>
  </section>

  <FAQ num={1} items={faqs} title="Fragen zur Garantie" />
  <FinalCTA num={2} />
</BaseLayout>
