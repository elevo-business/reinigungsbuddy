---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/ui/Photo.astro';
import SectionHeader from '~/components/sections/SectionHeader.astro';
import ServiceArea from '~/components/sections/ServiceArea.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import { site } from '~/config/site';
import { breadcrumbs } from '~/lib/schema';
import img from '~/assets/images/besprechungsraum-holztisch.jpg';
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Über uns', href: '/ueber-uns/' }];
const values = [
  { t: 'Zahlen statt Adjektive', x: 'Wir schreiben nicht „schnell", sondern „Festpreis in 24 Stunden". Nicht „gründlich", sondern „Reinigungsprotokoll nach jedem Einsatz". Daran können Sie uns messen.' },
  { t: 'Weniger versprechen, mehr halten', x: 'Kein 24/7-Notdienst, kein Heer von Ersatzkräften, keine Siegel, die wir nicht haben. Dafür Zusagen, die wir sicher einhalten.' },
  { t: 'Sichtbar statt unsichtbar', x: 'Gute Reinigung fällt nicht auf. Deshalb das Reinigungsprotokoll: damit Sie sehen, was passiert ist, ohne kontrollieren zu müssen.' },
  { t: 'Ein Gesicht, eine Nummer', x: 'Sie sprechen mit dem, der plant und reinigt. Keine Weiterleitung, kein Ticket, kein „Ich gebe das weiter".' },
];
---
<BaseLayout
  title="Über uns – Gebäudereinigung Berlin | Reinigungsbuddy"
  description={`Reinigungsbuddy ist eine junge, inhabergeführte Gebäudereinigung in Berlin. ${site.owner.firstName} plant und reinigt selbst. Festpreis 24 h nach Objektbegehung.`}
  schema={[breadcrumbs(crumbs, Astro.site!), { '@context': 'https://schema.org', '@type': 'AboutPage', url: new URL('/ueber-uns/', Astro.site).toString(), about: { '@id': new URL('/#business', Astro.site).toString() } }]}>
  <section class="wrap pb-16 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="grid-12 mt-8 gap-y-8">
      <div class="col-span-4 lg:col-span-10">
        <p class="eyebrow text-moss"><span class="num">01</span> — Über uns</p>
        <h1 class="mt-5 text-[clamp(2.35rem,5vw+0.6rem,5.25rem)] leading-[1]">Klein, inhaber&shy;geführt und genau deshalb verlässlich.</h1>
      </div>
      <div class="col-span-4 space-y-5 text-lead lg:col-span-7 lg:col-start-4">
        <p>Reinigungsbuddy ist eine junge Gebäudereinigung aus Berlin. Wir reinigen Büros, Praxen, Treppenhäuser und Gewerbeflächen in allen 12 Bezirken und machen dabei bewusst einiges anders als die großen Anbieter.</p>
        <p>Die meisten Reinigungsfirmen verlieren Kunden nicht wegen des Preises, sondern weil niemand zuständig ist. Bei uns ist immer jemand zuständig: {site.owner.firstName}, Inhaber, der jede Objektbegehung selbst macht, das Leistungsverzeichnis schreibt und selbst mit reinigt.</p>
      </div>
    </div>
  </section>
  <figure><Photo src={img} alt="Aufgeräumter Besprechungsraum mit langem Holztisch, Stühlen und großer Fensterfront" sizes="100vw" class="h-[50vh] max-h-[36rem] min-h-[16rem] w-full object-cover" /></figure>


  <section class="wrap py-20 lg:py-28" aria-labelledby="werte">
    <SectionHeader num={2} label="Wie wir arbeiten" title="Vier Regeln, an denen Sie uns messen können." id="werte" />
    <ol class="grid-12 mt-12 gap-y-10">
      {values.map((v, i) => (
        <li class="reveal col-span-4 border-t border-ink pt-5 lg:col-span-6">
          <span class="num font-display text-4xl font-semibold text-moss">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-2xl">{v.t}</h3>
          <p class="mt-2 max-w-xl text-stone">{v.x}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap pb-10" aria-labelledby="facts">
    <SectionHeader num={3} label="Fakten" title="Reinigungsbuddy in Kürze" id="facts" />
    <dl class="mt-10 grid border-t border-line sm:grid-cols-2 lg:grid-cols-3">
      {[
        ['Gegründet', '[PLATZHALTER: Gründungsjahr]'],
        ['Inhaber', `${site.owner.firstName} (${site.owner.fullName})`],
        ['Einsatzgebiet', 'Alle 12 Berliner Bezirke'],
        ['Sprachen', 'Deutsch, Englisch'],
        ['Kunden', 'Büros, Praxen, Kanzleien, Hausverwaltungen, Coworking'],
      ].map(([k, v]) => (
        <div class="border-b border-line py-4 sm:pr-6">
          <dt class="text-sm text-stone">{k}</dt>
          <dd class="mt-1 font-medium" set:html={v.replace(/\[PLATZHALTER:([^\]]*)\]/g, '<mark class="ph">[Platzhalter:$1]</mark>')} />
        </div>
      ))}
    </dl>
  </section>

  <ServiceArea num={4} />
  <FinalCTA num={5} />
</BaseLayout>
