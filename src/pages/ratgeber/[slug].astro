---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import Signet from '~/components/ui/Signet.astro';
import FAQ from '~/components/sections/FAQ.astro';
import { site } from '~/config/site';
import { article, breadcrumbs, faqPage } from '~/lib/schema';
import { shy } from '~/lib/text';

export async function getStaticPaths() {
  const items = await getCollection('ratgeber');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const url = new URL(`/ratgeber/${entry.id}/`, Astro.site).toString();
const services = await getCollection('leistungen');
const target = services.find((s) => s.id === d.service);
const others = (await getCollection('ratgeber')).filter((r) => r.id !== entry.id).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Ratgeber', href: '/ratgeber/' }, { name: d.title.split(':')[0], href: `/ratgeber/${entry.id}/` }];
const ogImg = await getImage({ src: d.image, width: 1200, format: 'jpg' });
const fmt = (dt: Date) => dt.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);
const isLv = entry.id === 'leistungsverzeichnis-bueroreinigung';
const ctaHref = isLv ? '#lv-article' : target ? `/angebot/?l=${target.data.preset.join(',')}` : '/angebot/';
const schema = [
  article({ title: d.title, description: d.metaDescription, url, image: new URL(ogImg.src, Astro.site).toString(), published: d.published, updated: d.updated, base: Astro.site! }),
  breadcrumbs(crumbs, Astro.site!),
  ...(d.faq ? [faqPage(d.faq, url)] : []),
];
---
<BaseLayout title={d.metaTitle} description={d.metaDescription} image="/og/ratgeber.png" type="article" schema={schema}>
  <article>
    <header class="wrap pb-10 pt-8 lg:pt-12">
      <Breadcrumbs items={crumbs} />
      <div class="grid-12 mt-8 gap-y-6">
        <div class="col-span-4 lg:col-span-10">
          <p class="eyebrow text-moss">Ratgeber · {d.readingMinutes} Min. Lesezeit</p>
          <h1 class="mt-5 text-[clamp(2.3rem,4.6vw+0.6rem,4.75rem)] leading-[1.02]">{shy(d.title)}</h1>
          <p class="mt-6 max-w-3xl text-lead">{d.excerpt}</p>
          <p class="mt-6 flex items-center gap-3 text-sm text-stone">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink"><Signet class="h-4 w-auto" /></span>
            <span>Von <a href="/ueber-uns/" class="link-moss">{site.owner.firstName}</a>, {site.owner.role} {site.name} · <time datetime={d.published.toISOString()}>{fmt(d.published)}</time>{d.updated && <> · aktualisiert <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>}</span>
          </p>
        </div>
      </div>
    </header>
    <figure class="wrap">
      <Photo src={d.image} alt={d.imageAlt} sizes="(min-width: 90rem) 1344px, 100vw" class="aspect-[21/9] w-full rounded-2xl object-cover" priority />
    </figure>

    <div class="wrap grid-12 gap-y-10 py-14 lg:py-20">
      <aside class="col-span-4 lg:col-span-3">
        <nav aria-label="Inhalt" class="lg:sticky lg:top-28">
          <p class="eyebrow">Inhalt</p>
          <ol class="mt-4 space-y-2.5 border-l border-line pl-4 text-[0.95rem]">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="text-stone hover:text-ink">{h.text}</a></li>)}
          </ol>
        </nav>
      </aside>
      <div class="col-span-4 lg:col-span-8 lg:col-start-5">
        <div class="prose-rb"><Content /></div>

        <div class="on-dark mt-14 rounded-2xl p-7 sm:p-9">
          <h2 class="text-3xl">{d.cta.title}</h2>
          <p class="mt-3 max-w-xl text-fog">{d.cta.text}</p>
          <a href={ctaHref} class="btn btn-primary mt-6">{d.cta.button}<Icon name="arrow" size={18} class="arrow" /></a>
          {target && <p class="mt-5 text-sm text-fog">Mehr zur Leistung: <a href={`/${target.id}/`} class="link-moss">{target.data.name} in Berlin</a></p>}
        </div>
      </div>
    </div>
  </article>

  {d.faq && <FAQ num={2} items={d.faq} title="Kurz beantwortet" />}

  <section class="wrap pb-20" aria-labelledby="more">
    <h2 id="more" class="border-t border-line pt-5 text-3xl">Weiterlesen</h2>
    <ul class="mt-8 grid gap-8 lg:grid-cols-3">
      {others.map((g) => (
        <li><a href={`/ratgeber/${g.id}/`} class="group block"><h3 class="text-xl transition-colors group-hover:text-moss">{g.data.title}</h3><p class="mt-2 text-stone">{g.data.excerpt}</p></a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
