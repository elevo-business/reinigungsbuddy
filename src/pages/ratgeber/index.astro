---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Photo from '~/components/ui/Photo.astro';
import LeadMagnetBlock from '~/components/sections/LeadMagnetBlock.astro';
import { breadcrumbs } from '~/lib/schema';
import { shy } from '~/lib/text';
const items = (await getCollection('ratgeber')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Start', href: '/' }, { name: 'Ratgeber', href: '/ratgeber/' }];
const [first, ...rest] = items;
---
<BaseLayout
  title="Ratgeber Büroreinigung | Reinigungsbuddy"
  description="Ratgeber zur Büroreinigung: Kostenfaktoren, Leistungsverzeichnis, Intervalle, Firmenwechsel und Praxishygiene. Verständlich, ohne Werbesprech."
  image="/og/ratgeber.png"
  schema={[breadcrumbs(crumbs, Astro.site!)]}>
  <section class="wrap pb-12 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow mt-8 text-moss"><span class="num">01</span> — Ratgeber</p>
    <h1 class="mt-5 max-w-5xl text-mega">Wissen, bevor Sie Angebote vergleichen.</h1>
    <p class="mt-6 max-w-2xl text-lead">Was eine Büroreinigung kostet und warum, wie oft gereinigt werden sollte und wie Sie die Reinigungsfirma ohne Lücke wechseln. Geschrieben von {`Mert`}, der selbst Büros in Berlin reinigt.</p>
  </section>

  {first && (
    <section class="wrap pb-16" aria-label="Neuester Artikel">
      <a href={`/ratgeber/${first.id}/`} class="group grid-12 gap-y-6 border-t border-line pt-6">
        <div class="zoom col-span-4 rounded-xl lg:col-span-7">
          <Photo src={first.data.image} alt={first.data.imageAlt} sizes="(min-width: 64rem) 55vw, 100vw" class="aspect-[16/10] w-full object-cover" />
        </div>
        <div class="col-span-4 lg:col-span-5">
          <p class="eyebrow text-stone">{first.data.readingMinutes} Min. Lesezeit</p>
          <h2 class="mt-3 text-display transition-colors group-hover:text-moss">{shy(first.data.title)}</h2>
          <p class="mt-4 text-lead text-stone">{first.data.excerpt}</p>
        </div>
      </a>
    </section>
  )}

  <section class="wrap pb-12" aria-label="Weitere Artikel">
    <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((g) => (
        <li class="reveal border-t border-line pt-6">
          <a href={`/ratgeber/${g.id}/`} class="group block">
            <div class="zoom rounded-xl"><Photo src={g.data.image} alt={g.data.imageAlt} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" widths={[480, 768, 1080]} class="aspect-[3/2] w-full object-cover" /></div>
            <p class="eyebrow mt-4 text-stone">{g.data.readingMinutes} Min. Lesezeit</p>
            <h2 class="mt-2 text-2xl transition-colors group-hover:text-moss">{shy(g.data.title)}</h2>
            <p class="mt-2 text-stone">{g.data.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <LeadMagnetBlock num={2} />
</BaseLayout>
