---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import MultiStepForm from '~/components/islands/MultiStepForm.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import { offerEn } from '~/config/offer.en';
import { breadcrumbs } from '~/lib/schema';
const crumbs = [{ name: 'Home', href: '/en/' }, { name: 'Contact', href: '/en/contact/' }];
---
<BaseLayout
  title="Request a Fixed Cleaning Quote in Berlin | Reinigungsbuddy"
  description="Request a fixed quote for office cleaning in Berlin: four short steps, reply on the same working day, fixed price within 24 h after a free site visit."
  image="/og/en.png"
  schema={[breadcrumbs(crumbs, Astro.site!)]}>
  <section class="wrap pb-20 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="grid-12 mt-8 gap-y-10">
      <div class="col-span-4 lg:col-span-4">
        <p class="eyebrow text-moss">Contact</p>
        <h1 class="mt-5 text-[clamp(2.4rem,4vw+0.8rem,4.5rem)] leading-[1.02]">Get a fixed quote within 24 hours.</h1>
        <p class="mt-6 text-lead">Four short steps, about two minutes. We reply on the same working day (enquiries after 4 pm: next working day) and arrange a free site visit, on site.</p>
        <TrustLine lang="en" class="mt-8 flex-col !gap-3" />
        <ol class="mt-10 space-y-4 border-t border-line pt-6">
          {offerEn.process.map((p, i) => (
            <li class="flex gap-4"><span class="num font-display font-semibold text-moss">{String(i + 1).padStart(2, '0')}</span><span><strong class="font-medium">{p.title}:</strong> <span class="text-stone">{p.text}</span></span></li>
          ))}
        </ol>
      </div>
      <div class="col-span-4 rounded-2xl border border-line bg-white/60 p-5 sm:p-8 lg:col-span-7 lg:col-start-6">
        <MultiStepForm lang="en" id="anfrage" heading={false} />
      </div>
    </div>
  </section>
</BaseLayout>
