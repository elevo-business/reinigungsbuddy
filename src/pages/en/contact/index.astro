---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import MultiStepForm from '~/components/islands/MultiStepForm.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import { offerEn } from '~/config/offer.en';
import { breadcrumbs } from '~/lib/schema';
const crumbs = [{ name: 'Home', href: '/en/' }, { name: 'Contact', href: '/en/contact/' }];
---
<BaseLayout
  title="Request a Fixed Cleaning Quote in Berlin | Reinigungsbuddy"
  description="Request a fixed quote for office cleaning in Berlin: three short steps, reply on the same working day, fixed price within 24 h after a free site visit."
  image="/og/en.png"
  schema={[breadcrumbs(crumbs, Astro.site!)]}>
  <section class="wrap pb-20 pt-8 lg:pt-12">
    <Breadcrumbs items={crumbs} />
    <div class="mt-8 grid gap-x-12 gap-y-8 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:row-start-1">
        <p class="eyebrow text-moss">Contact</p>
        <h1 class="mt-5 text-[clamp(2.2rem,3.6vw+0.8rem,4.2rem)] leading-[1.03]">Request a free site visit.</h1>
        <p class="mt-5 text-lead text-stone">Three short steps, about one minute. We reply on the same working day and arrange an appointment.</p>
      </div>
      <div class="rounded-2xl border border-line bg-white p-5 shadow-[0_24px_60px_-30px_rgb(15_46_35/0.35)] sm:p-8 lg:col-span-7 lg:row-span-2 lg:row-start-1">
        <MultiStepForm lang="en" id="anfrage" heading={false} />
      </div>
      <div class="lg:col-span-5 lg:row-start-2">
        <TrustLine lang="en" class="flex-col !gap-3" />
        <ol class="mt-8 space-y-4 border-t border-line pt-6">
          {offerEn.process.map((p, i) => (
            <li class="flex gap-4"><span class="num font-display font-semibold text-moss">{i + 1}.</span><span><strong class="font-medium">{p.title}:</strong> <span class="text-stone">{p.text}</span></span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
