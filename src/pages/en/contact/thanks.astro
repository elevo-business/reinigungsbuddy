---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Thank you | Reinigungsbuddy" description="Your enquiry has arrived. We reply on the same working day." noindex>
  <section class="wrap py-20 lg:py-28">
    <p class="eyebrow text-moss">Enquiry received</p>
    <h1 class="mt-5 max-w-4xl text-mega">Thank you! We’ll reply on the same working day.</h1>
    <p class="mt-6 max-w-2xl text-lead">Enquiries after 4 pm or at the weekend are answered on the next working day. Next: a free site visit, then your fixed quote within 24 hours.</p>
    <a href="/en/" class="btn btn-ghost mt-10">Back to the homepage</a>
  </section>
  <script>
    import { fireLeadConversion } from '~/lib/track';
    fireLeadConversion();
  </script>
</BaseLayout>
