---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Photo from '~/components/ui/Photo.astro';
import Icon from '~/components/ui/Icon.astro';
import TrustLine from '~/components/sections/TrustLine.astro';
import SectionHeader from '~/components/sections/SectionHeader.astro';
import ProcessSteps from '~/components/sections/ProcessSteps.astro';
import OfferStack from '~/components/sections/OfferStack.astro';
import FAQ from '~/components/sections/FAQ.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import { offerEn } from '~/config/offer.en';
import { site } from '~/config/site';
import { faqPage } from '~/lib/schema';
import { enServices } from '~/data/services-en';
import heroImg from '~/assets/images/buero-flur-glastueren-tageslicht.jpg';
const url = new URL('/en/', Astro.site).toString();
const faqs = [...offerEn.faq];
---
<BaseLayout
  title="Cleaning Company Berlin – Fixed Quote | Reinigungsbuddy"
  description="English-speaking cleaning company in Berlin for offices, startups and practices. One contact person, cleaning reports, fixed quote 24 h after a site visit."
  image="/og/en.png"
  whatsappText="Hello, I am interested in office cleaning in Berlin."
  schema={[faqPage(faqs, url)]}>
  <section class="wrap pb-14 pt-12 lg:pb-20 lg:pt-20">
    <div class="max-w-4xl">
      <p class="eyebrow text-moss">Cleaning company Berlin</p>
      <h1 class="mt-5 text-[clamp(2.5rem,5vw+0.8rem,5rem)] leading-[1.02]">Office cleaning in Berlin you don’t have to think about.</h1>
      <p class="mt-7 max-w-2xl text-lead text-stone">We clean offices, practices and stairwells across Berlin, in English if you prefer. You get one contact person, a cleaning report after every visit and your fixed-price quote within 24 hours of a free site visit.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/en/contact/" class="btn btn-primary">Request a free site visit<Icon name="arrow" size={18} class="arrow" /></a>
        <a href="/en/services/" class="btn btn-ghost">Our services</a>
      </div>
      <TrustLine lang="en" class="mt-9" />
    </div>
  </section>
  <figure class="wrap"><Photo src={heroImg} alt="Bright office corridor with glass doors, wooden floor and daylight" sizes="(min-width: 90rem) 1344px, 100vw" class="aspect-[4/3] w-full rounded-2xl object-cover sm:aspect-[21/9]" priority /></figure>

  <ProcessSteps steps={[...offerEn.process]} label="How it works" title="Three simple steps" />

  <section class="bg-paper-2/60 py-20 lg:py-24" aria-labelledby="services">
    <div class="wrap">
      <SectionHeader label="Services" title="Everything that needs to be clean" intro="From regular office cleaning to the move-out clean. One contact, one invoice." id="services" />
      <ul class="mt-12 grid gap-x-10 sm:grid-cols-2">
        {enServices.map((s) => (
          <li class="border-b border-line py-5">
            <span class="block font-display text-xl font-semibold tracking-tight">{s.name}</span>
            <span class="mt-1 block text-[0.95rem] text-stone">{s.text}</span>
          </li>
        ))}
      </ul>
      <a href="/en/office-cleaning-berlin/" class="link-moss mt-8 inline-block">More about office cleaning in Berlin</a>
    </div>
  </section>

  <OfferStack lang="en" />

  <section class="wrap pb-6" aria-labelledby="area">
    <div class="rounded-2xl border border-line p-6 sm:p-8">
      <h2 id="area" class="text-2xl">Serving all 12 Berlin districts</h2>
      <p class="mt-3 text-stone">{site.districts.map((d) => d.name).join(' · ')}</p>
    </div>
  </section>

  <FAQ num={1} items={faqs} title="Questions" />
  <FinalCTA num={2} lang="en" whatsappText="Hello, I would like a fixed quote for office cleaning." />
</BaseLayout>
